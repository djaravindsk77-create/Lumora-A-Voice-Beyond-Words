# Lumora environment configuration (template)
# Copy this file to `.env` and fill in real values.
# NEVER commit a real .env file with secrets to version control.
#
# The app runs fully in DEMO MODE without any of these values.
# All flags default to false / empty: Demo Mode stays active until
# Firebase is initialized with a valid google-services.json AND
# remote data is enabled in Settings.

# ---- Runtime mode ----
# demo | firebase
LUMORA_DATA_MODE=demo

# ---- Firebase (optional) ----
# Web/API key issued by the Firebase console (Android apps also need
# android/app/google-services.json - see README "Firebase setup").
LUMORA_FIREBASE_API_KEY=

# ---- AI features (optional) ----
# If empty, all AI features fall back to the built-in rule-based engine.
LUMORA_AI_API_KEY=
LUMORA_AI_ENDPOINT=

# ---- Feature flags (true/false) ----
LUMORA_ENABLE_AI=false
LUMORA_ENABLE_LOCATION=false
LUMORA_ENABLE_CLOUD_SYNC=false
